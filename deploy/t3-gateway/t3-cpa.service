[Unit]
Description=Dedicated restricted CPA instance (API-key-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=t3-cpa
Group=t3-cpa
UMask=0077
StateDirectory=t3-cpa
WorkingDirectory=/var/lib/t3-cpa
Environment=CPA_T3_ISOLATED=1
Environment=HOME=/var/lib/t3-cpa
UnsetEnvironment=MANAGEMENT_PASSWORD HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy PGSTORE_DSN GITSTORE_GIT_URL OBJECTSTORE_ENDPOINT
ExecStart=/usr/local/bin/CLIProxyAPI -config /etc/t3-cpa/config.yaml
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
